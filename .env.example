# Case management / IR platform (generic — any compatible API)
CASE_PLATFORM_URL=http://localhost:9000
CASE_PLATFORM_API_KEY=your_key_here
CASE_PLATFORM_SECRET=change-me-for-local-development
# Optional: override the case platform image (generic example)
# CASE_PLATFORM_IMAGE=example/case-platform:latest

# Corporate directory / identity provider (e.g., Entra ID, Okta, LDAP)
DIRECTORY_TENANT_ID=your_tenant_id
DIRECTORY_CLIENT_ID=your_client_id
DIRECTORY_CLIENT_SECRET=your_client_secret

# AlienVault OTX
OTX_API_KEY=your_key_here

# The Companies API (recipient business context — optional)
COMPANIES_API_KEY=your_key_here

# Config
POLLING_INTERVAL_SECONDS=30
FP_THRESHOLD_PERCENT=60
